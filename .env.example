# ExtrovertAI environment variables.
# Copy this file to `.env` and fill in values as you obtain them (see /docs/setup-credentials-md.md).
# This file (.env.example) IS committed. The real `.env` is NEVER committed.

# --- App ---
APP_NAME=ExtrovertAI
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
# Public URLs used to build links that must reach the browser/Stripe from OUTSIDE
# (Stripe Checkout success/cancel redirects, webhook callbacks). Leave blank for
# local dev (we fall back to http://localhost:WEB_PORT / :API_PORT); set to the
# tunnel/prod origins when testing webhooks (e.g. PUBLIC_API_URL=https://xxxx.ngrok.app).
PUBLIC_WEB_URL=
PUBLIC_API_URL=
# Starter credits granted once to each NEW account on first sign-in, so testing
# isn't blocked before Stripe top-up (File 14). Set to 0 to disable.
SIGNUP_CREDITS=100
# DEV-ONLY. When 'true', the login screen accepts any email/password: if
# sign-in fails with "invalid credentials" we silently sign up the pair first
# and retry sign-in. Only for local demos — leave EMPTY (or 'false') in any
# deployed environment. Requires "Confirm email" to be OFF in the Supabase
# dashboard (Auth → Providers → Email) so the auto-signup produces a session
# immediately instead of waiting for an email link.
DEV_AUTH_BYPASS=false
# How often (seconds) the worker polls connected mailboxes for replies/bounces (File 11).
REPLY_POLL_SECONDS=120
# Public base URL the unsubscribe link must be reachable at (File 11). In dev this
# defaults to http://localhost:${API_PORT}; in prod set it to your tunnel/public URL.
PUBLIC_API_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

# --- Redis / Queue ---
REDIS_URL=

# --- Google (Places + OAuth + Calendar) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Microsoft (Outlook) ---
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# --- Crawl / LLM ---
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
# Primary model (OpenRouter id). Free models are heavily rate-limited (429s) — the
# app retries + falls through to LLM_MODEL_FALLBACKS, but for reliable profile
# extraction / hooks / drafting use your own key or a small paid model.
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Comma-separated fallbacks tried in order when the primary is rate-limited/unavailable.
# Five reliable free models (verified to return clean content) across providers so a
# single provider's rate-limit never blocks extraction / hooks / drafting / assist.
LLM_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-nano-12b-v2-vl:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free

# --- System email (Resend) ---
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=

# --- Test mode ---
# When set, EVERY outbound campaign/reply email is diverted to this single inbox
# instead of the real business address (subject is prefixed with [TEST → original]).
# Leave EMPTY to send to real prospects. Great for safe end-to-end dry runs.
TEST_EMAIL=

# --- Booking (Cal.com) ---
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# --- Payments (Stripe) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
